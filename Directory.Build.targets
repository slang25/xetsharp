<Project>

  <!-- IsPackable is set by the projects themselves, which are evaluated after Directory.Build.props
       and before this file — so the README can only be attached to the packages from here. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
