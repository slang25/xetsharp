<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>An Amazon S3 storage backend for the XetSharp server: xorbs, file records and repositories as objects in one bucket, with xorb data served through presigned URLs.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../XetSharp.Server/XetSharp.Server.csproj" />
  </ItemGroup>

</Project>
